# Copie este arquivo para .env.local e preencha os valores.
# Na Vercel, cadastre as mesmas 3 variáveis em Settings > Environment Variables.

# String de conexão do MongoDB Atlas.
# Pegue em: Atlas > Database > Connect > Drivers.
# Troque <db_password> pela senha real do usuário do banco.
MONGODB_URI="mongodb+srv://usuario:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Nome do banco de dados (pode deixar assim).
MONGODB_DB="finpulseiq"

# Segredo para assinar a sessão de login. Gere um valor aleatório com:
#   openssl rand -base64 32
# (no Windows, use: https://generate-secret.vercel.app/32)
AUTH_SECRET="troque-por-um-valor-aleatorio-de-32-caracteres-ou-mais"
